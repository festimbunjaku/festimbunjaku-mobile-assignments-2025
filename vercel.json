{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/((?!_expo|assets|favicon\\.ico|metadata\\.json|.*\\.[a-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}

